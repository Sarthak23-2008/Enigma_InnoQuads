# ---- SafeBite backend configuration ----
# Copy to backend/.env for local development. Never commit .env. In production set these in the host dashboard.

# development | production
APP_ENV=development
# Local: SQLite file. Production: postgresql://USER:PASSWORD@HOST:5432/DBNAME (Render/Supabase/Railway/Neon)
DATABASE_URL=sqlite:///./safebite.db
# REQUIRED in production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# CORS: the deployed frontend origin(s), comma-separated
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
EXTRA_CORS_ORIGINS=

# OCR provider: tesseract (open source, default) | gemini (Google Gemini vision) | demo (bundled sample labels only)
OCR_PROVIDER=tesseract
# Only needed when OCR_PROVIDER=gemini
OCR_API_KEY=
OCR_LANG=eng
# Path to the tesseract binary if it is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
MAX_UPLOAD_MB=8
# Uploaded label images are NOT kept by default (only a SHA-256 reference is stored)
STORE_UPLOADS=false

# Scheduled reports: mock (logged + in-app outbox) | resend (real email)
NOTIFICATION_PROVIDER=mock
RESEND_API_KEY=
REPORT_FROM_EMAIL=SafeBite <reports@example.com>

# Seeds the clearly-labelled "Aryan Demo" account and enables one-click demo login
DEMO_MODE=true
LOG_LEVEL=INFO
